{
  "name": "bitewise",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm wasm:copy && next dev",
    "build": "pnpm wasm:copy && next build",
    "start": "next start",
    "lint": "eslint . && prettier --check . --log-level warn && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx db/seed/index.ts",
    "seed:build": "node --import tsx scripts/build-food-seed.ts",
    "wasm:copy": "node --import tsx scripts/copy-zxing-wasm.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "ops:build": "esbuild migrate=db/ops/migrate.ts seed=db/seed/index.ts bootstrap-admin=scripts/bootstrap-admin.ts --bundle --platform=node --target=node24 --format=cjs --outdir=ops --log-level=warning"
  },
  "dependencies": {
    "barcode-detector": "3.2.2",
    "drizzle-orm": "^0.45.3",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  }
}
