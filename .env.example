# Copy to .env: cp .env.example .env

# Postgres container (docker-compose.yml)
POSTGRES_USER=bitewise
POSTGRES_PASSWORD=bitewise
POSTGRES_DB=bitewise
# 5433, not 5432: avoids clashing with other local Postgres containers
POSTGRES_PORT=5433

# App and drizzle-kit
DATABASE_URL=postgres://bitewise:bitewise@localhost:5433/bitewise
# Separate database for tests (created by docker/postgres/init-test-db.sql)
DATABASE_URL_TEST=postgres://bitewise:bitewise@localhost:5433/bitewise_test

# Auth.js: generate with `openssl rand -base64 32`, at least 32 characters
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# The single admin account, created/synced by `pnpm admin:bootstrap` on every deploy.
# .invalid is a reserved TLD: no one can own it or receive mail for it.
ADMIN_EMAIL=admin@bitewise.invalid
# Generate with `openssl rand -base64 24`. Changing it here and re-running bootstrap rotates it.
ADMIN_PASSWORD=

# --- Production (docker-compose.prod.yml, /opt/bitewise/.env, chmod 600) ---
# The same file feeds compose (ports, domain, image) and the app container (DB, auth, admin).
# In production DATABASE_URL points at the compose service:
#   DATABASE_URL=postgres://bitewise:<POSTGRES_PASSWORD>@db:5432/bitewise
#   NEXTAUTH_URL=https://<DOMAIN>
# and POSTGRES_PASSWORD is a long random URL-safe value (openssl rand -hex 24), not "bitewise":
# it sits inside DATABASE_URL, where base64's "/" breaks parsing. No "$" in any value either —
# compose interpolates it.
# Public host name; certbot issues the certificate for it. "localhost" = local run, self-signed.
DOMAIN=
# Host part of redirects to https; differs from DOMAIN only with non-standard ports (localhost:8443).
PUBLIC_HOST=
# Let's Encrypt account email (expiry notices).
CERTBOT_EMAIL=
# Image tag the stack runs; release.sh passes it explicitly, this is the fallback.
IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
# 31536000 (a year) in production; 0 locally, or the browser pins localhost to https.
HSTS_MAX_AGE=31536000
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# How long release.sh waits for the new app to answer /api/health, and scripts for the database.
HEALTH_WAIT_SEC=60
DB_WAIT_SEC=60
