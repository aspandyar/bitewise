# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only variables set in the container are substituted: ${DOMAIN}, ${PUBLIC_HOST},
# ${HSTS_MAX_AGE}, ${NGINX_LOCAL_RESOLVERS}. nginx's own $variables stay as they are.

# Outer brake on password guessing and sign-up bursts, per client IP; the app has its own limits.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
# Only POSTs to /register count: an empty key is not limited, so opening the page stays free.
map $request_method $register_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $register_key zone=register:10m rate=5r/m;
limit_req_status 429;

# No version in Server headers and nginx's own error pages.
server_tokens off;

# Requests for any other host name (or the bare IP) get nothing: the app only ever sees its own
# domain in Host, which Next uses for server-action origin checks.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${PUBLIC_HOST}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Mozilla "intermediate": forward secrecy and AEAD only on TLS 1.2.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 0 locally: a year of HSTS on localhost would push every dev server to https.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json;

    # Forms and JSON only for now; photos (stage 11) raise this.
    client_max_body_size 1m;

    # `app` is resolved per request, so nginx starts (and keeps answering 503) while the app
    # container is down or not created yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $app http://app:3000;

    proxy_http_version 1.1;
    # $http_host keeps the port (localhost:9443 on a local run): Next compares it with Origin
    # before running a server action.
    proxy_set_header Host $http_host;
    # Appends the peer nginx saw; the app takes the rightmost entry (TRUSTED_PROXY_HOPS = 1), so a
    # client-supplied X-Forwarded-For cannot dodge per-IP limits.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    # During a restart the app is unreachable: a 503 with Retry-After lets clients (and the
    # useOffline retry) wait instead of seeing a dropped connection.
    proxy_intercept_errors off;
    error_page 502 503 504 =503 /maintenance.json;

    location = /maintenance.json {
        internal;
        root /etc/nginx/templates;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        # A location's own add_header drops the server-level ones, so HSTS is repeated here.
        add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
    }

    # For the container healthcheck and release.sh, which call it inside the container; from outside
    # it would only be a free database ping.
    location = /api/health {
        return 404;
    }

    location /api/auth/callback/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $app;
    }

    location = /register {
        limit_req zone=register burst=3 nodelay;
        proxy_pass $app;
    }

    location / {
        proxy_pass $app;
    }
}
